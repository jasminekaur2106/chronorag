# Copy this file to .env and fill in your own values. NEVER commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://chrono:chrono@localhost:5433/chronorag

# LLM provider: "gemini" (has a free tier) or "anthropic"
LLM_PROVIDER=gemini

# Get a free Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local embedding model (free, runs on your CPU, 384 dimensions)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Frontend dev server origin(s), comma separated
CORS_ORIGINS=http://localhost:5173
